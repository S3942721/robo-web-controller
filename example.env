# Model Configuration
MODEL_ID=amazon.nova-sonic-v1:0
BEDROCK_MODEL_REGION=us-east-1
AWS_REGION=us-east-1
DEFAULT_REGION=ap-southeast-2
S3_BUCKET_NAME=
BEDROCK_CLAUDE_MODEL_ID=

# Network Configuration
SERVER_HOST=0.0.0.0 # Listen on all interfaces
SERVER_PORT=3000
SOCKET_PORT=3456

# STT Configuration
STT_SERVER_HOST=10.0.0.2
STT_SERVER_PORT=8765
STT_LLM_ENABLED=true

# LLM Configuration
LLM_GATEWAY_HOST=wss://...
LLM_CHUNK_MODE=smart
# Options: 
# - raw: Send chunks directly to robot (fastest, may break mid-word/sentence)
# - pattern: Preserve ^ and {} patterns only
# - smart: Preserve patterns AND sentence boundaries (most fluid speech)

# Smart chunking configuration
LLM_MIN_CHUNK_LENGTH=5
LLM_MAX_BUFFER_SIZE=200
LLM_SENTENCE_MARKERS=.!?

# WebSocket Configuration
WS_RECONNECT_ATTEMPTS=5
WS_RECONNECT_DELAY=2000

# Robot Identification Configuration
ROBOT_IDENTIFICATION_METHOD=socket
# Options: 
# - ip: Identify robots by IP address only
# - socket: Identify robots by socket data only  
# - both: Try IP first, then fallback to socket data

# Robot IP to Name Mapping
HAKU_IP=192.168.1.100
BANDIT_IP=192.168.1.101

# Default robot name for unknown connections
DEFAULT_ROBOT_NAME=Haku